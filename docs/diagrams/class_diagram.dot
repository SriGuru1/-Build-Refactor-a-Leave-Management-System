digraph D {
  rankdir=BT; nodesep=0.35; ranksep=0.55; dpi=200; newrank=true;
  node [shape=record, fontname="DejaVu Sans", fontsize=10, style=filled, fillcolor="#EAF1FB", color="#2F5597", margin="0.10,0.06"];
  edge [fontname="DejaVu Sans", fontsize=9, color="#2F5597"];

  Emp [label="{«abstract» Employee|- employeeId, name, department : String  «final»\l- type : EmployeeType  «final»\l- annualEntitlement : int  «final»\l- leaveBalance, leaveYear : int\l- history : List\<LeaveRequest\>\l|+ applyLeave(int) : LeaveRequest\l+ applyLeave(int, String) : LeaveRequest  «final»\l+ applyLeave(LocalDate, LocalDate, String)\l+ cancelLeave(int) : LeaveRequest\l+ checkLeaveBalance() : int\l+ startNewLeaveYear() : int\l+ displayDetails() / getDetails()\l+ getMaxDaysPerRequest() : int  «abstract»\l+ getCarryForwardLimit() : int  «abstract»\l# getBenefitNote() : String\l}", fillcolor="#FFF4D6", color="#B7791F"];
  FT  [label="{FullTimeEmployee|24 days/yr, max 10/request,\lcarry-forward 5\l|+ getMaxDaysPerRequest()\l+ getCarryForwardLimit()\l}"];
  PT  [label="{PartTimeEmployee|12 days/yr, max 5/request,\lcarry-forward 2\l|+ getMaxDaysPerRequest()\l+ getCarryForwardLimit()\l}"];
  IN  [label="{Intern|6 days/yr, max 2/request,\lcarry-forward 0\l|+ getMaxDaysPerRequest()\l+ getCarryForwardLimit()\l}"];
  MG  [label="{Manager  (change request)|+6 bonus days, max 15/request,\lcarry-forward 10\l|+ getMaxDaysPerRequest()\l+ getCarryForwardLimit()\l# getBenefitNote()\l}", fillcolor="#E3F2E1", color="#2E7D32"];
  LR  [label="{LeaveRequest|- requestId, leaveYear, days : int\l- reason : String\l- requestedOn : LocalDate\l- status : LeaveStatus\l|~ cancel()\l}", fillcolor="#E8F5E9", color="#2E7D32"];
  ST  [label="{«enumeration» LeaveStatus|APPROVED\lCANCELLED\l}", fillcolor="#F3E5F5", color="#6A1B9A"];
  ET  [label="{«enumeration» EmployeeType|FULL_TIME, PART_TIME,\lINTERN, MANAGER\l}", fillcolor="#F3E5F5", color="#6A1B9A"];
  WD  [label="{«utility» WorkingDayCalculator|+ countWorkingDays(from, to)\l}", fillcolor="#F3E5F5", color="#6A1B9A"];
  LE  [label="{LeaveException|extends Exception (checked)\l}", fillcolor="#FDECEA", color="#B71C1C"];
  E1  [label="{InvalidLeaveRequest-\lException}", fillcolor="#FDECEA", color="#B71C1C"];
  E2  [label="{InsufficientLeaveBalance-\lException}", fillcolor="#FDECEA", color="#B71C1C"];
  E3  [label="{LeaveRequestNotFound-\lException}", fillcolor="#FDECEA", color="#B71C1C"];
  Main [label="{Main / TestRunner|console demo (all printing)\l55 automated tests\l}", fillcolor="#FFF4D6", color="#B7791F"];

  FT -> Emp [arrowhead=empty, label=" extends"];
  PT -> Emp [arrowhead=empty];
  IN -> Emp [arrowhead=empty];
  MG -> FT  [arrowhead=empty, label=" extends"];
  Emp -> LR [arrowhead=none, arrowtail=diamond, dir=both, label=" 0..*  history"];
  LR -> ST  [arrowhead=vee, style=dashed, label=" uses"];
  Emp -> ET [arrowhead=vee, style=dashed, label=" uses"];
  Emp -> WD [arrowhead=vee, style=dashed, label=" uses"];
  E1 -> LE [arrowhead=empty]; E2 -> LE [arrowhead=empty]; E3 -> LE [arrowhead=empty];
  Emp -> LE [arrowhead=vee, style=dashed, label=" throws"];
  Main -> Emp [arrowhead=vee, style=dashed, label=" uses"];
  {rank=same; FT; PT; IN;}
  {rank=same; ST; ET; WD;}
}
